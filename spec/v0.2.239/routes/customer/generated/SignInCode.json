  "$id": "https://aretta.ai/spec/routes/customer/generated/SignInCode.json",
  "type": "string",
  "description": "every sign-in code: the vocabulary's sign_in layer (scripts/codes_vocab.py), in its order; the page maps it to its signin.* sentence",
