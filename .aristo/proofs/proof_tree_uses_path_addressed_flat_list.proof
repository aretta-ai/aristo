[verified.proof]
conclusion = "ProofFile represents the proof tree as a flat Vec<ProofStep>, where each step is addressed by a dotted-path string field (path: String) and references children via subgoal_paths: Vec<String>. The Rust types do not encode recursion via a nested enum or recursive struct."

[[verified.proof.steps]]
path = "0"
claim = "ProofStep encodes its tree address as a dotted-path String, not by being a recursive struct that owns its subgoals."
relation_to_parent = "decomposes"

