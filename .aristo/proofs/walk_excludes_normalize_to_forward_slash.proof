attempts = 1
property_kind = "invariant"

[verified.proof]
conclusion = "WalkOptions::excludes_path normalizes rel by iterating Path::components() and joining with '/', so glob matching sees forward-slash strings on every host. A rel.to_str() shortcut would preserve the platform separator on Windows and silently make patterns like **/tests/ui/** never match."

[[verified.proof.steps]]
path = "0"
claim = "On all platforms, the string fed to self.excludes.is_match(...) uses '/' as the sole component separator, independent of std::path::MAIN_SEPARATOR."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-core/src/walk/fs.rs"
lines = "113-120"
code_text_hash = "sha256:8000d9a65310860ef348e18ceeae3fbd72352b45a6051a6d875e04a0a3c4e9c0"
reason = """rel.components().map(...).join("/") — the join literal is '/', not MAIN_SEPARATOR."""

[[verified.proof.steps]]
path = "1"
claim = '''Globset patterns of the form **/tests/ui/** match against the literal candidate string and do not treat '\' as a path separator, so a '\'-separated candidate would not match a '/'-based pattern; the failure mode is silent under-exclusion (fail-open).'''
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-core/src/walk/fs.rs"
lines = "109-121"
code_text_hash = "sha256:37eab2ab7a4371efd41c4ef11e6ffb14251fc36a67fd56bd8806019bc7d065c4"
reason = "Function returns self.excludes.is_match(rel_str) directly — no error on mismatch; a non-matching exclude means walk_directory_with does NOT continue past the file, so it gets indexed."

[[verified.proof.steps.grounds]]
kind = "intent"
id = "walk_directory_is_deterministic"
at_text_hash = "sha256:882dd7497428ca92d4907c6dc4e8bf3436ecf8bbb5050947645bdb76bb9af843"
relation = "composes"
reason = "Sibling annotation confirms the exclude filter is consulted in the same loop that yields the indexed annotations."
