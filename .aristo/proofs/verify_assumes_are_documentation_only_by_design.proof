attempts = 2
property_kind = "invariant"

[verified.proof]
conclusion = "resolve_verify_level early-returns VerifyLevel::Bool(false) for every IndexEntry::Assume(_) regardless of its contents, routing assumes into the same Bool(false) arm in run that handles intent opt-outs (verify=false). That arm runs no skill, no test, no signed outcome (documented by sibling intent verify_false_arm_is_intentional_skip). The design is enforced structurally upstream: AssumeEntry is serde(deny_unknown_fields) and lists no verify field, so an assume entry cannot opt INTO any verification method at parse time or via construction. A refactor that tried to verify assumes would first have to change the schema (contradicting the design choice that assumes describe external trust, not properties of THIS code) or branch on assume-specific semantics that do not exist. The invariant holds."

[[verified.proof.steps]]
path = "0"
claim = "For every IndexEntry::Assume(_), resolve_verify_level returns VerifyLevel::Bool(false) unconditionally, and the Bool(false) arm in run is the single skip-without-skill path shared with verify=false intents — so assumes are documentation-only by design."
relation_to_parent = "composes"
subgoal_paths = [
    "0.0",
    "0.1",
    "0.2",
]

[[verified.proof.steps.grounds]]
kind = "composition"
reason = "Conjunction of sub-claims 0.0 (assumes always resolve to Bool(false)), 0.1 (the Bool(false) arm is the shared single skip-without-skill path), and 0.2 (the schema makes verifying assumes structurally impossible). Together these discharge the parent claim that assumes are documentation-only by design."

[[verified.proof.steps]]
