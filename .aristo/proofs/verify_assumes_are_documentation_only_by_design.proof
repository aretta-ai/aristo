[verified.proof]
conclusion = "Assume entries carry no verify field by design and resolve_verify_level returns VerifyLevel::Bool(false) for them, which the dispatcher handles via the same skip-without-skill arm that documentation-only intents (verify=false) use."

[[verified.proof.steps]]
path = "0"
claim = "For every IndexEntry::Assume(_), resolve_verify_level returns VerifyLevel::Bool(false), and the dispatcher routes that value to the skip-without-skill arm shared with opt-out intents."
relation_to_parent = "composes"
subgoal_paths = [
    "0.0",
    "0.1",
    "0.2",
]

[[verified.proof.steps.grounds]]
kind = "composition"
reason = "Subgoals 0.0, 0.1, 0.2 combine via AND: (a) AssumeEntry has no verify field structurally, (b) resolve_verify_level returns Bool(false) for Assume unconditionally, (c) the Bool(false) arm in the dispatcher is the same skip-without-skill arm as opt-out intents."

[[verified.proof.steps]]
path = "0.0"
claim = "AssumeEntry has no verify field. verify is only a member of IntentEntry, so there is no per-annotation verification level to dispatch on for assume entries."
relation_to_parent = "decomposes"

