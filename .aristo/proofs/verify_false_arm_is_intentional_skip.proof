reason = "Reading the arm verbatim: `VerifyLevel::Bool(false) => { aristo::intent_stmt!(...); stats.skipped_doc_only += 1; }`. Two statements total."

[[verified.proof.steps]]
path = "0.0"
claim = "The `aristo::intent_stmt!` macro invocation is a documentation marker that the extractor reads at index time; it does not invoke any skill, run any test, or write any signed outcome at runtime — it expands to a no-op (or effectively no-op) for the compiled binary."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "intent"
id = "stmt_form_intents_use_open_visit_descent_not_whitelist"
at_text_hash = "sha256:1be10f580efbb4857173d91ded4f73ee87ea18e2193d3d2b841b8126a64f575d"
relation = "instantiates"
reason = "Documents that stmt-form intents (like `intent_stmt!`) are DISCOVERED via syn::Visit traversal at extraction time — i.e., they are source-level markers for the indexer, not runtime dispatch hooks. There is no SDK→skill or SDK→test plumbing wired through the macro expansion."

[[verified.proof.steps.grounds]]
kind = "intent"
id = "pending_neural_file_is_sdk_to_agent_request_not_a_result"
at_text_hash = "sha256:5d04f4f2136735e523ef1b12a43f0f5862be2ff7542cb69416271144b3c8259c"
relation = "instantiates"
reason = "Establishes the architectural invariant that the SDK CLI never makes LLM/skill calls directly — agent invocation happens only via the pending-neural request file written by `pending::write_pending_neural`. The Bool(false) arm does not touch `pending_neural`, `pending_test`, or `pending_full`, so by this design rule it cannot invoke any skill."

[[verified.proof.steps]]
path = "0.1"
claim = "`stats.skipped_doc_only += 1;` is a local counter increment used only by `emit_summary` for the user-facing 'N skipped' line. It writes no proof file, no index mutation, no signed outcome to disk."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/mod.rs"
lines = "115-151"
code_text_hash = "sha256:3bdb558da846b00e5c9bf979fd89c03b9bf5bcc8cc95a267c25d9b03ba752a67"
reason = "`Stats` is a `#[derive(Default, Debug)] struct` with two `usize` fields, owned locally in `fn run` (line 53: `let mut stats = Stats::default();`). It is consumed only by `emit_summary` (line 94) which `println!`s the count. No filesystem writes, no signed-outcome emission."

[[verified.proof.steps]]
path = "0.2"
claim = "Signed outcomes (proof files + index status mutations) are written exclusively by the `apply::run_apply_verdicts` branch (returned early at line 47 before the dispatch loop) and by `pending::write_pending_neural` (line 91, only reached when `pending_neural` is non-empty). The Bool(false) arm neither falls into apply nor pushes onto `pending_neural`, so it cannot reach either signed-outcome writer."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/mod.rs"
lines = "46-91"
code_text_hash = "sha256:49ee622d9f9f62fffa5fa3d243068422e2ba8e77258a25744d713d3e06f1be62"
reason = "Control flow: `if apply_verdicts { return apply::run_apply_verdicts(...); }` (line 46-48) short-circuits before the loop. Inside the loop, only `VerifyLevel::Method(VerifyMethod::Neural)` pushes to `pending_neural` (line 83); `Bool(false)` only increments `stats.skipped_doc_only`. `pending::write_pending_neural` (line 91) runs only `if !pending_neural.is_empty()`."

