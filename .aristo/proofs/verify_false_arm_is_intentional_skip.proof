[verified.proof]
conclusion = "The VerifyLevel::Bool(false) match arm in fn run (mod.rs:67-78) invokes no skill, runs no test, and writes no signed outcome. Its only effect is the `aristo::intent_stmt!` documentation macro (the covered statement itself, which expands to a no-op marker the extractor reads) and incrementing `stats.skipped_doc_only`. This is the intentional documentation-only skip path, structurally identical to the assume-entry path that `verify_assumes_are_documentation_only_by_design` documents on the same dispatcher."

[[verified.proof.steps]]
path = "0"
claim = "The VerifyLevel::Bool(false) arm body contains exactly two items: the `aristo::intent_stmt!` macro invocation (the covered statement) and `stats.skipped_doc_only += 1;`. No other statements, no function calls beyond the counter mutation."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/mod.rs"
