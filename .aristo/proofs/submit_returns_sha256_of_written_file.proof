[verdict]
type = "verified"
method = "neural"
produced_at_text_hash = "sha256:1cd3494cdce2019142ec33788c70f98216ec0896cceb8b63b7343b1fd8487f84"
produced_at_body_hash = "sha256:476ab3733a15987f3ad0df829be69e009ac0afca3146a3a15bc875e645ad4367"
produced_by = "aristo-neural-verifier@v0.0.6"
attempts = 2
property_kind = "invariant"

[verified.proof]
conclusion = "On accept, run_submit_verdict prints `accepted: sha256:<hex>` to stdout where <hex> is body_hash of the on-disk TOML body, providing an integrity anchor the orchestrator can compare against body_hash(returned_text) without re-reading the file."

[[verified.proof.steps]]
path = "0"
claim = "On a successful submit, stdout receives exactly one `accepted: sha256:<hex>` line whose hex is the sha256 of the on-disk TOML body of the just-written .proof file."
relation_to_parent = "decomposes"
subgoal_paths = [
    "0.0",
    "0.1",
    "0.2",
]

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/submit.rs"
lines = "108-124"
code_text_hash = "sha256:41e842bacdc43cb219298edc853f915e26c16b776a61cb21b5a17fef64491b44"
reason = 'The accept path: write_proof_atomic lands the TOML, then std::fs::read_to_string(&path) re-reads it from disk into `written`, body_hash(&written) computes the sha256, and println!("accepted: {h}") prints it. The hash is computed from the on-disk byte stream, not from the in-memory ProofFile, which is the integrity claim.'

[[verified.proof.steps.grounds]]
kind = "intent"
id = "submit_verdict_is_only_write_path_for_proofs"
at_text_hash = "sha256:aeb403650a57ce9b32dcdf5c7ce1d212cb3fe93d5f8af01f0f5826d53a3ddd96"
relation = "composes"
reason = "This same function is the SOLE writer of .proof files, so the body whose hash is printed is authoritative — no other path could have written a different body for this id concurrently."

[[verified.proof.steps]]
path = "0.0"
claim = "The hex emitted in `accepted: sha256:<hex>` is sha256 of the on-disk TOML body bytes (not the in-memory ProofFile, not the JSON input)."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/submit.rs"
lines = "114-118"
code_text_hash = "sha256:464146ec75abdb1cf1b0d15c570578e1346a9310c8aa91bae151c71e3a5327ef"
reason = "`let written = std::fs::read_to_string(&path)?; let h = body_hash(&written);` — the input to body_hash is the bytes read back from `path`, the file write_proof_atomic just produced. Re-reading then hashing is what anchors the print to the on-disk content rather than to any in-memory value."

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-core/src/hash.rs"
lines = "44-46"
code_text_hash = "sha256:88d5a35ecfc7dac83c9bf5ddab9ede6bebd2f4b97645f05f428db0d3a0bf4e9f"
reason = "body_hash is verbatim sha256 over the input bytes — `Sha256::from_bytes(body.as_bytes())` — with no normalization, so the hex it returns is the true sha256 of the file content."

[[verified.proof.steps.grounds]]
kind = "intent"
id = "body_hash_is_verbatim"
at_text_hash = "sha256:e95670473c6cdceaa8221ae7737fb289b9fe8dfbc3a1ca6d85a49e7c2fe365ea"
relation = "composes"
reason = "Verbatim semantics guarantee the printed hex is byte-identical to whatever the orchestrator computes via the same body_hash over the text the subagent returns, enabling the cheap integrity check."

[[verified.proof.steps]]
path = "0.1"
claim = "The emitted line has the literal `accepted: ` prefix followed by the canonical `sha256:<64-hex>` form."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/submit.rs"
lines = "124-124"
code_text_hash = "sha256:aed9172b8972d5eb74be780f93729c48b96c00f3fa852b2eabdfed5ee5be743d"
reason = '`println!("accepted: {h}")` — the literal `accepted: ` prefix is hardcoded, and `{h}` Displays a Sha256 value.'

[[verified.proof.steps.grounds]]
kind = "intent"
id = "sha256_from_bytes_is_canonical_form"
at_text_hash = "sha256:ad55ed98136c35f699a6f08c7a5ef8782ca3f77944ffcfbdae0a2b249da6f3fd"
relation = "composes"
reason = "Sha256 produced by from_bytes is in canonical form `sha256:<64 lowercase hex chars>`; combined with the println prefix, the full line is exactly `accepted: sha256:<hex>` as the intent specifies."

[[verified.proof.steps]]
path = "0.2"
claim = "The print happens only on the accept path (post-validation, post-write, post-stamp), so a printed `accepted:` line implies the file actually landed."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/submit.rs"
lines = "97-124"
code_text_hash = "sha256:9bf727d877b227920ee1fb2a1d714ebc0d8f30fa69a78b342d5b6ac846ceb795"
reason = "The println at line 124 is preceded by: validate() returning empty (line 97-101 short-circuits on errors), stamp_ground_hashes (line 106), create_dir_all + write_proof_atomic (line 109-112), and read-back (line 114-117). Every failure in this sequence returns Err before reaching the println, so observing the line on stdout proves the artifact reached disk."

[[verified.proof.steps.grounds]]
kind = "intent"
id = "submit_validation_matches_apply_validation"
at_text_hash = "sha256:c4506ca7cf8649dadb6b0b178ec20fb2430647c39e732a81835580b548e8ddea"
relation = "composes"
reason = "Because submit-time validation is the same gate as --apply-verdicts, a printed `accepted:` also implies the validator accepted the proof — the orchestrator gets both write confirmation and validation confirmation from one line."
