[verdict]
type = "verified"
method = "neural"
produced_at_text_hash = "sha256:5d04f4f2136735e523ef1b12a43f0f5862be2ff7542cb69416271144b3c8259c"
produced_at_body_hash = "sha256:0a64adcfb7cd5cabb22bc832f493b32f94f62fc242f29dc12f1d8290ef0eee5f"
produced_by = "aristo-neural-verifier@v0.0.5"
attempts = 1
property_kind = "invariant"

[verified.proof]
conclusion = "The pending-neural.toml file is written by the SDK as a one-way request to the in-agent skill: the CLI never reads it back to perform LLM work, and the only path that mutates index status from a neural verdict is --apply-verdicts, which mechanically validates skill-produced .aristo/proofs/<id>.proof files."

[[verified.proof.steps]]
path = "0"
claim = "The CLI writes pending-neural.toml as a request and does not read it back to perform verification work itself."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/pending.rs"
lines = "40-84"
code_text_hash = "sha256:328654bd33dbaffd6dd30a729232e30665a67a483bd7c8c38c0a3a57ea3f99dd"
reason = "write_pending_neural only serializes PendingEntry rows and atomic-writes them; no reciprocal read_pending_neural exists."

[[verified.proof.steps]]
path = "1"
claim = "The only status-mutating path for neural verdicts is --apply-verdicts, which reads skill-produced .proof files and gates them through the mechanical validator before any index update."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/apply.rs"
lines = "21-45"
code_text_hash = "sha256:d96a66f3050eaf4f0b0cc2641ac026a96f2d2c3ef63bdaee1cc5fe80f6b523c2"
reason = "run_apply_verdicts reads .aristo/proofs/ files, parses them, calls validate(..); rejections do NOT update the index — only accepted proofs proceed to apply_status_updates."

[[verified.proof.steps]]
path = "2"
claim = "Both failure modes the intent calls out (CLI auto-reading pending file → LLM call; agent bypassing validator) are absent: no LLM client is invoked in the verify command tree, and no path writes status without traversing validate(..)."
relation_to_parent = "composes"

[[verified.proof.steps.grounds]]
kind = "prior-step"
path = "0"
reason = "CLI doesn't auto-read pending file."

[[verified.proof.steps.grounds]]
kind = "prior-step"
path = "1"
reason = "All status writes traverse validate()."

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/pending.rs"
lines = "40-84"
code_text_hash = "sha256:328654bd33dbaffd6dd30a729232e30665a67a483bd7c8c38c0a3a57ea3f99dd"
reason = "write_pending_neural uses only aristo_core, serde, toml, std::fs, atomic_write — no HTTP/LLM client imports."
