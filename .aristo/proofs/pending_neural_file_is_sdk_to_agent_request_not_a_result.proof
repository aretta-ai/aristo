[verdict]
type = "verified"
method = "neural"
produced_at_text_hash = "sha256:5d04f4f2136735e523ef1b12a43f0f5862be2ff7542cb69416271144b3c8259c"
produced_at_body_hash = "sha256:774d3742fe3fe941b6886dbf9b0a34361eac1b7409c3bef88bfdadcd7a5f0a07"
produced_by = "aristo-neural-verifier@v0.0.6"
attempts = 1
property_kind = "invariant"

[verified.proof]
conclusion = "write_pending_neural emits a request file consumed by the in-agent skill; the SDK never reads it back to invoke an LLM, and the only path from agent verdict to disk goes through the SDK validator via --submit-verdict / --apply-verdicts."

[[verified.proof.steps]]
path = "0"
claim = "The pending file is produced by the SDK as a request to the in-agent skill (per the module contract), and the design split CLI-never-calls-LLM / agent-never-bypasses-validator is preserved by the SDK code at this site."
relation_to_parent = "composes"
subgoal_paths = [
    "0.0",
    "0.1",
]

[[verified.proof.steps.grounds]]
kind = "composition"
reason = "Combines subgoal 0.0 (SDK writes, does not consume, the pending file) with 0.1 (the only verdict-to-disk path is the SDK validator) to discharge the no-conflation claim."

[[verified.proof.steps]]
path = "0.0"
claim = "write_pending_neural only produces the pending-neural.toml file from the index; nothing in this module reads the pending file back or invokes an LLM, so the SDK side cannot dispatch verification work itself."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/pending.rs"
lines = "1-14"
code_text_hash = "sha256:fe827611506f73edc374dfd7b8c77e312a86d0ad384f9a9bec0de745c1cae51f"
reason = "Module docstring states verbatim that the file is the request (not the result), that the skill reads it, dispatches per-entry work, writes proofs, and calls --apply-verdicts."

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/pending.rs"
lines = "65-112"
code_text_hash = "sha256:ce30374bb1a310331ce1ff40f4350a07bbe934f0ae24acbd6a4323da2282a248"
reason = "write_pending_neural builds PendingEntry values from the in-memory IndexFile and atomic_writes pending-neural.toml; no read of that file, no network/LLM call, no subprocess dispatch."

[[verified.proof.steps]]
path = "0.1"
claim = "The only write path from agent verdict to .aristo/proofs/<id>.proof is the SDK validator (submit-verdict / apply-verdicts), so the agent cannot bypass the SDK even if a refactor tried to short-circuit dispatch."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "intent"
id = "submit_verdict_is_only_write_path_for_proofs"
at_text_hash = "sha256:aeb403650a57ce9b32dcdf5c7ce1d212cb3fe93d5f8af01f0f5826d53a3ddd96"
relation = "composes"
reason = "Sibling invariant: aristo verify --submit-verdict is the SINGLE write path for .proof files; subagents have no Write-tool access. This is the gate that makes the design split enforceable on the agent side."

[[verified.proof.steps.grounds]]
kind = "intent"
id = "apply_prunes_pending_for_landed_verdicts"
at_text_hash = "sha256:4b2f36a26d77486d506052020c65cc4b30ec6cc17237cdbcfd4b498659535dd2"
relation = "composes"
reason = "Confirms the canonical loop: SDK writes pending file -> skill reads it and writes proofs -> SDK --apply-verdicts validates and prunes. The pending file is consumed by the skill, never re-read by the SDK to drive its own verification."
