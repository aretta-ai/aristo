[verdict]
type = "verified"
method = "neural"
produced_at_text_hash = "sha256:ba18af9e829dde60b9199ffa949fd9b2b8ca0ba04d3dac5673052f00eb0e069c"
produced_at_body_hash = "sha256:347ffd07951d721cf37075335bee35f17410af1cd38f12b5e793f3ee5715db67"
produced_by = "aristo-neural-verifier@v0.0.6"
attempts = 2
property_kind = "invariant"

[verified.proof]
conclusion = "Pending verify tasks are SDK-to-agent requests, not results: enqueue_pending writes per-id task files under .aristo/verify-queue/pending/<id>.toml; the SDK never reads them back to materialize verdicts; verdicts arrive only via aristo verify --submit-verdict and the SDK is the sole writer of .aristo/proofs/<id>.proof after mechanical validation. The CLI never makes LLM calls and the agent never bypasses the SDK validator."

[[verified.proof.steps]]
path = "0"
claim = "Pending verify tasks are SDK-to-agent REQUESTs enqueued at .aristo/verify-queue/pending/<id>.toml, workers pop one at a time via aristo verify --pop-next, and the SDK never reads task files back as verdicts — verdicts arrive only via aristo verify --submit-verdict and land at .aristo/proofs/<id>.proof after the mechanical validator gates them."
relation_to_parent = "decomposes"
subgoal_paths = [
    "0.0",
    "0.1",
    "0.2",
    "0.3",
]

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/pending.rs"
lines = "62-105"
code_text_hash = "sha256:5bc456b4fc16d771fe96715a7402e7e26c237b9f9faddaea5a0bce54a23493d3"
reason = "enqueue_pending iterates the ids it was given and writes one task per id into the per-pipeline queue at pending/<id>.toml via queue::enqueue (line 98). It only produces tasks; it has no read-back / dispatch / LLM-call path."

[[verified.proof.steps]]
path = "0.0"
claim = "Each enqueued task lands under .aristo/verify-queue/pending/<id>.toml — the per-pipeline pending/ directory that workers poll."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/pending.rs"
lines = "67-98"
code_text_hash = "sha256:18952b7ce1dde9e5a2a86ab64903344d93c7c0d42497272965aec65f59dfd3fe"
reason = 'QueueDir::for_pipeline(ws, PIPELINE_NAME) selects the verify pipeline subtree; PIPELINE_NAME = "verify" (line 26); queue::enqueue(&qdir, id, &task_toml) writes the per-id task file.'

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/pipeline/queue.rs"
lines = "113-121"
code_text_hash = "sha256:5acb903c0fac1bd51e9d9dc17b5bbec419614770e63c199d5348baa676cce5a4"
reason = "queue::enqueue computes qdir.pending_path(id) and atomic-writes the task body, so the task file lives at the per-pipeline pending/ directory under the queue root."

[[verified.proof.steps.grounds]]
kind = "intent"
id = "queue_dir_is_per_pipeline_namespace"
at_text_hash = "sha256:a88536476d35af7d102c46f75f5063bfcfff95f9296d63581696430605711da1"
relation = "instantiates"
reason = "The verify-pipeline queue lives at .aristo/verify-queue/, with pending/ as a sibling of claimed/ — verifies the SDK-to-agent transport path is per-pipeline and namespaced."

[[verified.proof.steps]]
path = "0.1"
claim = "Workers claim one task at a time via aristo verify --pop-next, which atomically renames pending/<id>.toml to claimed/<id>.toml; the CLI itself does not auto-iterate the queue to call an LLM."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/mod.rs"
lines = "62-64"
code_text_hash = "sha256:811cbc6991221a6efb2911880bd31ab7da4aa37dca7a171cf24ac27a7d0bcc5a"
reason = "The --pop-next flag in run() dispatches to run_pop_next and returns; there is no LLM call, no looping over the queue from inside aristo verify itself."

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/mod.rs"
lines = "162-173"
code_text_hash = "sha256:d19ae2281b24c1ae7f1be225d5a9f4d700329d3149801483af2dade3b9e60490"
reason = "run_pop_next prints exactly one popped task body (or nothing on drained) and returns Ok — single-task contract, no batching or self-dispatch."

[[verified.proof.steps.grounds]]
kind = "intent"
id = "verify_pop_next_prints_task_or_empty_exit_zero"
at_text_hash = "sha256:0da73449029c5ac290374f71589048e283bb0c913c998a23d1c344347f81978e"
relation = "instantiates"
reason = "Confirms --pop-next is the worker-facing one-task-at-a-time API and is the only way the queue is drained, leaving the agent (not the CLI) responsible for processing each task."

[[verified.proof.steps.grounds]]
kind = "intent"
id = "pop_next_uses_atomic_rename_for_race_safety"
at_text_hash = "sha256:cb34810dee70f2d7a8c4be45ab2b0cec9cd76cc6fff55a6d58bcff37f01a01ab"
relation = "composes"
reason = "pop_next is implemented by atomic rename from pending/ to claimed/, which is what enables the one-worker-per-task SDK→agent handoff model the intent describes."

[[verified.proof.steps]]
path = "0.2"
claim = "The SDK never reads pending task files back as verdicts; the only path that materializes a .proof is aristo verify --submit-verdict, invoked by an external agent submitting JSON."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/mod.rs"
lines = "35-147"
code_text_hash = "sha256:d782ade78e1e613380e4fa083e7b9a304f4f2a01d278a69cd10424cda40c992e"
reason = "The full run() body — the only entry point for `aristo verify` — only ever (a) responds to --submit-verdict / --pop-next / --queue-status / --apply-verdicts dispatch flags, or (b) iterates the index, classifies entries, calls enqueue_pending, and emits a summary. There is no code path that opens .aristo/verify-queue/pending/<id>.toml to read a verdict, no LLM client, no auto-dispatch loop."

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/submit.rs"
lines = "74-126"
code_text_hash = "sha256:f895c41e65ae54c440ad5576d8165b649087f74a017b51b093aa14317b5c3f8f"
reason = "run_submit_verdict is invoked only when the external caller (the agent) passes --submit-verdict --id --json; it parses the supplied JSON ProofFile, validates it, then write_proof_atomic lands the verdict at .aristo/proofs/<id>.proof. The JSON arrives from the agent; the SDK never synthesizes one from the queue file."

[[verified.proof.steps.grounds]]
kind = "intent"
id = "submit_verdict_is_only_write_path_for_proofs"
at_text_hash = "sha256:aeb403650a57ce9b32dcdf5c7ce1d212cb3fe93d5f8af01f0f5826d53a3ddd96"
relation = "composes"
reason = "Independent intent on submit.rs asserts --submit-verdict is the SINGLE write path for .proof files — directly composes with this intent's claim that the SDK does not auto-produce verdicts from the queue."

[[verified.proof.steps]]
path = "0.3"
claim = "The submit path validates every verdict through the mechanical validator before the .proof file lands on disk, so the agent cannot bypass the SDK validator even via the submit channel."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/submit.rs"
lines = "97-112"
code_text_hash = "sha256:b13915698b585c1d1d2ab472390b74d39b7b0e0eae09ded3ed786429d16e61fd"
reason = "validate(&id, &pf, index, &ws.root) is run first; if the report is non-empty the function returns an error BEFORE write_proof_atomic is called. Only validator-passing JSON reaches the proofs/ directory."

[[verified.proof.steps.grounds]]
kind = "intent"
id = "submit_validation_matches_apply_validation"
at_text_hash = "sha256:c4506ca7cf8649dadb6b0b178ec20fb2430647c39e732a81835580b548e8ddea"
relation = "composes"
reason = "The submit-time validator is the same validate() used by --apply-verdicts, closing the only remaining gap where an agent might 'sneak past' validation."
