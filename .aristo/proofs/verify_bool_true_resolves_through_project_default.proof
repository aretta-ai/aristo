code_text_hash = "sha256:6ddacfcfc31f05d0cf9cdff973d28dc482f2e84fcf8c20745fcb3d6c89538b51"
reason = "The None arm constructs `VerifyLevel::Method(VerifyMethod::Test)` with an inline `// free-tier default` comment. `Test` is the documented free-tier default per G1; the fallback is encoded once here and not duplicated elsewhere in the dispatcher. The unit test `bool_true_falls_back_to_test_when_no_project_default` (lines 416-424) asserts: with a default ConfigFile (default_method=None), Bool(true) resolves to Method(Test)."

