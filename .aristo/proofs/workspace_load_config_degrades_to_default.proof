property_kind = "invariant"

[verified.proof]
conclusion = "Workspace::load_config returns ConfigFile::default() on any failure to read or parse aristo.toml — never errors — so reader commands stay functional under a malformed or missing config."

[[verified.proof.steps]]
path = "0"
claim = "load_config has return type ConfigFile (non-fallible signature), so it cannot propagate parse or IO errors to callers."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/workspace.rs"
lines = "108-108"
code_text_hash = "sha256:52da79675850628bfe1f02a9a635ea65a1b55066e0f6614c76a1b3e843f1b0e6"
reason = "Signature pub fn load_config(&self) -> ConfigFile — no Result/Option wrapper."

[[verified.proof.steps]]
path = "1"
claim = "Missing or unreadable aristo.toml degrades to ConfigFile::default() via let-else on fs::read_to_string."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/workspace.rs"
lines = "109-109"
code_text_hash = "sha256:2a05667335ece12d723ea751f4f283342582a2e8a00a242538cf3a2629908cab"
reason = "let Ok(text) = std::fs::read_to_string(self.config_path()) else { return ConfigFile::default(); } — every Err arm routes to default."

[[verified.proof.steps]]
path = "2"
claim = "Malformed TOML degrades to ConfigFile::default() via unwrap_or_default on toml::from_str."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/workspace.rs"
lines = "112-112"
code_text_hash = "sha256:f2ddb5da050846c9a2f7f49845da3c9a650c949b2bf495ba0d2deca38f072559"
reason = "toml::from_str(&text).unwrap_or_default() — any parse error maps to default."
