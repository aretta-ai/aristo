attempts = 1
property_kind = "invariant"

[verified.proof]
conclusion = "The Bool(false) match arm in fn run is an intentional skip: it invokes no skill, runs no test, writes no signed outcome, and only increments the in-memory stats.skipped_doc_only counter. The arm's body is exhaustively two items — an aristo::intent_stmt! macro (compile-time annotation metadata, not runtime dispatch) and the counter bump. Module-level documentation and the Stats field doc-comment both describe this arm as the deliberate skip path for verify=false (and, via resolve_verify_level, for assumes). A refactor that adds a skill call here would erase the user-visible distinction between verify=false and verify='neural', defeating the opt-out semantic."

[[verified.proof.steps]]
path = "0"
claim = "The Bool(false) arm body contains only the intent_stmt! macro and the stats.skipped_doc_only counter increment — no skill invocation, no test execution, no proof write."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/mod.rs"
lines = "80-91"
code_text_hash = "sha256:c61da08cd757c886b34b3e99d20f670ac1266a37a82cabf86d07805881211ed9"
reason = "The entire arm body is two items: the aristo::intent_stmt! macro (compile-time annotation, no runtime dispatch effect) at lines 81-89, and stats.skipped_doc_only += 1 at line 90. There is no pending_neural.push, no fs::write to a proof path, no NotImplemented return, no skill spawn — only an in-memory counter bump. The match arm satisfies the intent's three negatives literally: no skill, no test, no signed outcome."

[[verified.proof.steps]]
path = "1"
claim = "The skip shape is intentional per design — module documentation and the Stats field doc-comment explicitly call out the verify=false arm as 'skipped without invoking any skill or updating status'."
relation_to_parent = "composes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/mod.rs"
lines = "1-14"
code_text_hash = "sha256:6eb4b242c8d15fb7efeba3e02b71781fd5ec35ef43ab523267110cbcced21abd"
reason = "Module doc-comment names the 'verify = false no-op arm' as a shipped slice-22 feature and contrasts it with the other arms that return NotImplemented with a slice pointer. The no-op is presented as the design, not a stub awaiting completion."

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/mod.rs"
lines = "131-139"
code_text_hash = "sha256:233ff2c97344006145fffc34b8dd16df54432fe1784e9e34e60188b00d78a43e"
reason = "Stats::skipped_doc_only doc-comment: 'Annotations with verify = false: documentation only, skipped without invoking any skill or updating status.' This pins the contract — the arm MUST not invoke a skill and MUST not update status. The intent text mirrors this verbatim."

[[verified.proof.steps]]
path = "2"
claim = "The counterfactual harm follows from the dispatcher's structural shape: a skill-invoking arm pushes into pending_neural and triggers downstream skill dispatch; adding such a push to the Bool(false) arm would route opt-out entries (and assumes that piggyback via resolve_verify_level) through the verification pipeline, erasing the user-visible distinction the opt-out semantic depends on."
relation_to_parent = "composes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/mod.rs"
lines = "95-105"
code_text_hash = "sha256:2a752881780151c03436eec32fad255bfb3998e70c322a4d8719792251bfaaf3"
reason = "The VerifyMethod::Neural arm pushes the id into pending_neural; downstream at lines 103-105, write_pending_neural emits .aristo/pending-neural.toml — the SDK-to-agent request that triggers actual skill work. A 'completing' refactor of the Bool(false) arm would add a similar push, sending verify=false entries down the exact same pipeline as verify='neural' — there is no other dispatch mechanism in this function to add a skill call through. The opt-out semantic depends on Bool(false) NOT joining that queue."

[[verified.proof.steps.grounds]]
kind = "intent"
id = "verify_assumes_are_documentation_only_by_design"
at_text_hash = "sha256:52a7f47cb64e5ff1cbf3eb2bf9d3fbada34b756a1ed78158e8e54ea8e0d4e51a"
relation = "composes"
reason = "Sibling invariant on resolve_verify_level establishes that the dispatcher's single 'skip-without-skill' path serves both opt-out intents AND assumes (which resolve to Bool(false) at line 254). Adding a skill call to this arm would simultaneously break the verify=false opt-out and force a verification semantic onto assumes that the design explicitly rejects."
