[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-core/src/index/entry.rs"
lines = "70-87"
code_text_hash = "sha256:a9518220ccc90595462b566b29d6d56bc0edc7e91e50652e672b4f45b5ffca30"
reason = "AssumeEntry is #[serde(deny_unknown_fields)] and its fields are {text, status, text_hash, body_hash, file, site, covered_region, linked, parent} — no verify. The module doc (lines 4-13) records the design: assume has no verify because assumptions are not verification targets, and the tagged-enum encoding makes `AssumeEntry { verify: Some(...) }` a compile error rather than a runtime rejection. So a refactor trying to verify assumes would have to first change the schema, which is exactly the design choice the parent intent says is rejected."
