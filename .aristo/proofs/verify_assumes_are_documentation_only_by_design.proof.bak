[verdict]
type = "verified"
method = "neural"
produced_at_text_hash = "sha256:52a7f47cb64e5ff1cbf3eb2bf9d3fbada34b756a1ed78158e8e54ea8e0d4e51a"
produced_at_body_hash = "sha256:47a6992664050a69cc2739f41caab782724deba6a78e93f1763149535cc150cb"
produced_by = "aristo-neural-verifier@v0.0.6"
attempts = 1
property_kind = "invariant"

[verified.proof]
conclusion = "resolve_verify_level early-returns VerifyLevel::Bool(false) for every IndexEntry::Assume(_) regardless of the assume entry contents. This routes assumes to the same Bool(false) arm in run that handles intent opt-outs (verify=false), where the dispatcher records skipped_doc_only without invoking any skill. The design is enforced structurally upstream: AssumeEntry has no verify field at all (serde deny_unknown_fields), so an assume carrying verify = is rejected at parse time, and constructing AssumeEntry { verify: ... } is a compile error. Together: (a) assumes cannot opt INTO verification at the schema level, and (b) the dispatcher cannot accidentally route an assume to a verification skill, since the Method(..) arms are unreachable for assumes. A refactor adding a verification path for assumes would have to either add a verify field to AssumeEntry (changing the on-disk schema and contradicting the A5 design that assumes describe external trust, not THIS code) or branch on assume-specific verification semantics that do not exist in the project. The invariant holds."

[[verified.proof.steps]]
path = "0"
claim = "For every IndexEntry::Assume(_), resolve_verify_level returns VerifyLevel::Bool(false) unconditionally, before any inspection of assume-entry fields, and the Bool(false) arm in run is the single skip-without-skill path shared with verify=false intents."
relation_to_parent = "composes"
subgoal_paths = [
    "0.0",
    "0.1",
    "0.2",
]

[[verified.proof.steps.grounds]]
kind = "composition"
reason = "Conjunction of sub-claims 0.0 (assumes always resolve to Bool(false)), 0.1 (the Bool(false) arm is the shared single skip-without-skill path), and 0.2 (the schema rules out an alternative verification path for assumes a priori). Together these discharge the parent claim that assumes are documentation-only by design."

[[verified.proof.steps]]
path = "0.0"
