[verdict]
type = "verified"
method = "neural"
produced_at_text_hash = "sha256:aeb403650a57ce9b32dcdf5c7ce1d212cb3fe93d5f8af01f0f5826d53a3ddd96"
produced_at_body_hash = "sha256:6deab6258bce4bd37effadc90f99b64682da788d88aa1ad98abdb89e57839692"
produced_by = "aristo-neural-verifier@v0.0.6"
attempts = 1
property_kind = "invariant"

[verified.proof]
conclusion = "Across crates/aristo-cli/src/, the only function that serializes a ProofFile to .aristo/proofs/<id>.proof is write_proof_atomic in apply.rs, and it is called from exactly two sites — submit.rs (new verdicts) and apply.rs (stamp-on-accept rewrites). Both call sites are strictly downstream of validate() returning an empty report. No other module writes proof BODY: stamp.rs only removes orphan proofs (fs::remove_file), pending.rs only renames <id>.proof to <id>.proof.bak (fs::rename). The single-write-path-per-validate-gate invariant holds."

[[verified.proof.steps]]
path = "0"
claim = "submit.rs is the only writer of NEW verdicts to .aristo/proofs/<id>.proof, and apply.rs only re-writes proofs that have ALREADY passed the same mechanical validator; together these are the only two write paths, both validator-gated."
relation_to_parent = "composes"
subgoal_paths = [
    "0.0",
    "0.1",
    "0.2",
]

[[verified.proof.steps.grounds]]
kind = "composition"
reason = "Conjoins (a) the validator-gated NEW-verdict write in submit.rs (step 0.0), (b) the validator-gated stamp-on-accept rewrite in apply.rs (step 0.1), and (c) the absence of any other writer of .proof body content in the CLI crate (step 0.2)."

[[verified.proof.steps]]
path = "0.0"
claim = "submit.rs run_submit_verdict calls write_proof_atomic ONLY after validate() returned an empty report; on any failure it returns early without touching disk."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/submit.rs"
lines = "90-119"
code_text_hash = "sha256:4b77ec16683c891eeecbb48c878bb18c42bc73bedec0787693fa6113591cc707"
reason = "Lines 95-99 run validate() and short-circuit with CliError::Silent on a non-empty report; only the empty-report fall-through reaches lines 104-110 (stamp_ground_hashes + write_proof_atomic). There is no other write of pf in this function (the read_to_string at line 112 is a read-back, not a write). Therefore every NEW verdict that lands on disk has passed validate()."

[[verified.proof.steps]]
path = "0.1"
claim = "apply.rs run_apply_verdicts calls write_proof_atomic ONLY for proofs whose validate() already returned an empty report; the rejection branch pushes to `rejections` and `continue`s without writing."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/apply.rs"
lines = "39-78"
code_text_hash = "sha256:d1ba197dbf364338c2a7fb61d1a23e10e1206f11971a1f595128a6c12e344459"
reason = "Lines 61-66 run validate() and push to rejections + continue on a non-empty report; only the empty-report fall-through reaches lines 71-74 where stamp_ground_hashes runs and write_proof_atomic is conditionally invoked. The rewrite at line 73 therefore cannot land an unvalidated proof — the proof body it re-serializes has already cleared the same validator gate that submit.rs uses."

[[verified.proof.steps]]
path = "0.2"
claim = "No other module in crates/aristo-cli/src/ writes .proof BODY content; stamp.rs only deletes orphan proofs, pending.rs only renames .proof to .proof.bak. write_proof_atomic is the sole serializer and atomic_write_via_tempfile_rename guarantees no torn writes."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/stamp.rs"
lines = "140-165"
code_text_hash = "sha256:10b6ab5d0b2d05daa665b0b75a370282dbdfd4415664a140bc2f39c7d5564919"
reason = "cascade_delete_orphan_proofs constructs <id>.proof paths only to pass to fs::remove_file; there is no fs::write / atomic_write / write_proof_atomic call here. It removes content; it never emits it."

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/pending.rs"
lines = "147-169"
code_text_hash = "sha256:117fe5ae27702481eba553d3e94cdd1d6ef72e2e2fab1df71480a2c065f0bd59"
reason = "backup_existing_proof renames <id>.proof to <id>.proof.bak via fs::rename. The earlier atomic_write at line 111 targets pending-neural.toml, not the proofs directory. Pending never writes proof body content."

[[verified.proof.steps.grounds]]
kind = "intent"
id = "atomic_write_via_tempfile_rename"
at_text_hash = "sha256:bdb434ee177536ea137913a9c9ef700c2e326b2a07d2ad1942321b17e6ebff73"
relation = "composes"
reason = "write_proof_atomic delegates to atomic_write, whose tempfile-rename property guarantees no partial-file state. So the single-writer-per-validate-gate invariant also implies single ATOMIC writes — there is no half-written proof a future reader could mistake for valid."
