[verdict]
type = "verified"
method = "neural"
produced_at_text_hash = "sha256:a159b79648667c153c9917813799f8a7f6465885707e3c17a94b6f0907e8fd4b"
produced_at_body_hash = "sha256:21bc2fdeaea0cb6c238f46e8f71331e03d021715d7398a99da007d19ed980ba8"
produced_by = "aristo-neural-verifier@v0.0.6"
attempts = 2
property_kind = "postcondition"

[verified.proof]
conclusion = "After --apply-verdicts accepts a proof for id X, the sweep block runs exactly the three idempotent cleanups: it removes any prior <id>.proof.bak, clears claimed/<id>.toml via submit_done (no-op if absent), and removes pending/<id>.toml if it survived an out-of-band write."

[[verified.proof.steps]]
path = "0"
claim = "The sweep block at apply.rs:101-111 executes the three cleanup actions for every accepted update, gated on updates being non-empty."
relation_to_parent = "decomposes"
subgoal_paths = [
    "0.0",
    "0.1",
    "0.2",
]

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/apply.rs"
lines = "82-112"
code_text_hash = "sha256:d1f956c26f45d977e2eee4877e4e069716ad21da5a48bce3f477ea5f46850412"
reason = "Outer block: when updates is non-empty, the function calls apply_status_updates, then iterates updates and performs the three sweep actions per id."

[[verified.proof.steps.grounds]]
kind = "composition"
reason = "Subgoals (a),(b),(c) combine via AND to establish the full straggler sweep."

[[verified.proof.steps]]
path = "0.0"
claim = "(a) Any prior-attempt <id>.proof.bak is deleted when present, with absence tolerated."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/apply.rs"
lines = "102-105"
code_text_hash = "sha256:02a7c765514090c59133d5298e66ea2198f50edc52d28820c9604b2842a4c51c"
reason = "Computes bak via proof_bak_path_for(ws, id); guards on is_file() then remove_file with `let _ =` so absence is silently fine — matches the .proof.bak deletion clause of the intent."

[[verified.proof.steps]]
path = "0.1"
claim = "(b) The claimed/<id>.toml entry is cleared idempotently via submit_done — a no-op when the worker already cleared it via submit-verdict."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/apply.rs"
lines = "97-106"
code_text_hash = "sha256:9c6169fd05965d98e0cc4dc4f27d3a095a6fdf9007ce8d6b22fc52b7c4991666"
reason = "Constructs the per-pipeline QueueDir, then calls pipeline::queue::submit_done(&qdir, id) to remove the claimed entry."

[[verified.proof.steps.grounds]]
kind = "intent"
id = "submit_done_is_idempotent_on_missing_claimed"
at_text_hash = "sha256:9070413f2bc853a6b1d84aecbdf624efd53463b136e25e22f66773dc520e4109"
relation = "instantiates"
reason = "submit_done treats NotFound on the claimed file as success — exactly the no-op-if-already-cleared semantic the focal intent requires."

[[verified.proof.steps]]
path = "0.2"
claim = "(c) Any straggler pending/<id>.toml is cleared after submit_done, covering the out-of-band-submit case."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/apply.rs"
lines = "107-110"
code_text_hash = "sha256:747f52fd94127a4bc94bbd8fb9a48c7360da1b75ddf75d69f9f699da875d000c"
reason = "Computes pending_path via QueueDir::pending_path; guards on is_file() then remove_file with `let _ =` so absence is fine — matches the pending/<id>.toml clause for the rare out-of-band-submit case."

[[verified.proof.steps.grounds]]
kind = "intent"
id = "queue_dir_is_per_pipeline_namespace"
at_text_hash = "sha256:a88536476d35af7d102c46f75f5063bfcfff95f9296d63581696430605711da1"
relation = "composes"
reason = "QueueDir::for_pipeline scopes the pending_path/claimed_path lookups to .aristo/verify-queue/, ensuring the sweep only touches verify-pipeline stragglers and not critique."
