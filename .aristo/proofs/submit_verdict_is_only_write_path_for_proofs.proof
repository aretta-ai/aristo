[verdict]
type = "verified"
method = "neural"
produced_at_text_hash = "sha256:083cd7c4b6f469bf5f11525a98cbf3f0340b6571b7b316e69dfcde63d136ee69"
produced_at_body_hash = "sha256:476ab3733a15987f3ad0df829be69e009ac0afca3146a3a15bc875e645ad4367"
produced_by = "aristo-neural-verifier@v0.0.6"
attempts = 3
property_kind = "invariant"

[verified.proof]
conclusion = "Every .aristo/proofs/<id>.proof file that lands on disk has passed the validate() schema gate, because submit-verdict is the sole creation path and apply-verdicts is the only path that may re-write an existing proof in-place, and both invoke validate() before any write."

[[verified.proof.steps]]
path = "0"
claim = "All proof-file writes in the CLI flow through write_proof_atomic, and every call site to write_proof_atomic invokes validate() and short-circuits on failure before writing."
relation_to_parent = "decomposes"
subgoal_paths = [
    "0.0",
    "0.1",
]

[[verified.proof.steps.grounds]]
kind = "composition"
reason = "Sub-goals 0.0 (sole creation path = submit) and 0.1 (apply may only re-write after validate) jointly establish the conclusion via AND."

[[verified.proof.steps]]
path = "0.0"
claim = "run_submit_verdict is the only function in the codebase that creates a fresh .aristo/proofs/<id>.proof file, and it calls validate() prior to write_proof_atomic, returning early on any validator finding."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/submit.rs"
lines = "73-125"
code_text_hash = "sha256:f895c41e65ae54c440ad5576d8165b649087f74a017b51b093aa14317b5c3f8f"
reason = "run_submit_verdict body: parse JSON → validate() at line 96 → on non-empty report eprintln+Err (lines 97-100) → stamp_ground_hashes → write_proof_atomic at line 111. The write only executes after the validator returns an empty report."

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/apply.rs"
lines = "239-245"
code_text_hash = "sha256:9da2e45afc41d46cf06e79c57c4952168beadf8e1365925921a22520985c8954"
reason = "write_proof_atomic definition. Its only two callers in the crate are submit.rs:111 (creation) and apply.rs:75 (in-place re-write); no third writer exists."

[[verified.proof.steps]]
path = "0.1"
claim = "run_apply_verdicts only re-writes an existing proof after the same validate() function returns empty; on a non-empty report it pushes to rejections and continues without calling write_proof_atomic."
relation_to_parent = "decomposes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "crates/aristo-cli/src/commands/verify/apply.rs"
lines = "41-80"
code_text_hash = "sha256:d1ba197dbf364338c2a7fb61d1a23e10e1206f11971a1f595128a6c12e344459"
reason = "Per-proof loop: read raw → ProofFile::parse → validate() at line 63 → on non-empty report push to rejections and `continue` (lines 64-68) → only on empty report do stamp_ground_hashes + conditional write_proof_atomic (lines 73-76) fire."

[[verified.proof.steps.grounds]]
kind = "intent"
id = "submit_validation_matches_apply_validation"
at_text_hash = "sha256:c4506ca7cf8649dadb6b0b178ec20fb2430647c39e732a81835580b548e8ddea"
relation = "composes"
reason = "Sibling intent fixes the invariant that submit and apply call the SAME validate() function with the same rules, so the gate at apply.rs:63 is the same gate as at submit.rs:96."
